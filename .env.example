# ─────────────────────────────────────────────────────────────
# RQdinn Client OS — environment configuration
# Copy to .env.local and fill in. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string (Supabase recommended; Neon, RDS, self-hosted also work).
# Supabase: Project Settings → Database → Connection pooling (Transaction mode, port 6543).
# Leave empty to use the embedded PostgreSQL (PGlite) stored in PGLITE_DATA_DIR —
# ideal for local development and demos, zero setup.
DATABASE_URL=
PGLITE_DATA_DIR=./.data/pglite
# Run migrations automatically on server start when using DATABASE_URL (otherwise: npm run db:migrate).
AUTO_MIGRATE=false

# File storage: "local" (disk) or "supabase" (private Supabase Storage bucket — use this on Vercel).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage/uploads
# Server-side only. Never expose the service role key to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=client-files
# Max upload size in megabytes.
MAX_UPLOAD_MB=25

# Public URL of the app (used in links inside notifications / PDFs).
APP_URL=http://localhost:3000

# Session lifetime in days.
SESSION_TTL_DAYS=14

# true = demo mode: one-click demo accounts on the login screen, auto-seeded demo data
# (embedded DB only) and the in-app demo reset. Set to false for real data — this also
# blocks `npm run db:seed` / `db:reset` from overwriting the database.
DEMO_MODE=true

# ── Future integrations (not required for the MVP) ──────────────
# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM="RQdinn <hello@rqdinn.com>"
# WhatsApp Business Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# SMS
SMS_PROVIDER_API_KEY=
# Google (Calendar / Drive)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# E-signature provider
ESIGN_PROVIDER=
ESIGN_API_KEY=
